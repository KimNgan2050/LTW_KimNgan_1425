@model IEnumerable<BTT3_KimNgan.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="luxe-admin-container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="luxe-admin-title">QUẢN LÝ DANH MỤC</h2>
            <p class="text-muted small text-uppercase tracking-wider">Quản lý các danh mục sản phẩm thời trang hệ thống LUXÉ</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-luxe-dark">
                + THÊM DANH MỤC MỚI
            </a>
        </div>
    </div>

    <div class="table-responsive luxe-table-wrapper">
        <table class="table table-hover align-middle m-0">
            <thead>
                <tr>
                    <th style="width: 20%;">Mã ID</th>
                    <th style="width: 50%;">Tên danh mục</th>
                    <th style="width: 15%;">Số sản phẩm thuộc nhóm</th>
                    <th style="width: 15%;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-light text-dark border tracking-wider">#@item.Id</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.Name</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary text-white">@item.Products.Count() sản phẩm</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group gap-2 justify-content-end">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary luxe-btn-action">
                                    Sửa
                                </a>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger luxe-btn-action">
                                    Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .luxe-admin-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .luxe-admin-title {
        font-family: 'Playfair Display', 'Inter', sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #111111;
        margin: 0;
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    .btn-luxe-dark {
        background-color: #111111;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 12px 24px;
        border-radius: 0;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-luxe-dark:hover {
            background-color: #333333;
            color: #ffffff;
        }

    .luxe-table-wrapper {
        border: 1px solid #eeeeee;
        background-color: #ffffff;
    }

        .luxe-table-wrapper th {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-uppercase: uppercase;
            letter-spacing: 1px;
            background-color: #fafafa;
            color: #555555;
            padding: 16px;
            border-bottom: 1px solid #eeeeee;
        }

        .luxe-table-wrapper td {
            padding: 16px;
            border-bottom: 1px solid #f6f6f6;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

    .luxe-btn-action {
        border-radius: 0;
        font-size: 12px;
        padding: 5px 14px;
    }
</style>
