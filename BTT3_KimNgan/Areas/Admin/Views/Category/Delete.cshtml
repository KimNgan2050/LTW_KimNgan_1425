@model BTT3_KimNgan.Models.Category

@{
    ViewData["Title"] = "Xác nhận xóa danh mục - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="luxe-admin-card p-5 border border-danger">
                <div class="mb-4 text-center">
                    <h2 class="luxe-form-title text-danger">XÁC NHẬN XÓA DANH MỤC</h2>
                    <p class="text-muted small text-uppercase tracking-wider mt-2">Hành động này không thể hoàn tác!</p>
                    <hr />
                </div>

                <div class="alert alert-warning py-3 mb-4">
                    <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>CẢNH BÁO NGUY HIỂM!</h5>
                    <p class="mb-0 small" style="line-height: 1.6;">
                        Bạn đang chuẩn bị xóa danh mục <strong>"@Model.Name"</strong>. 
                        Danh mục này hiện chứa <strong>@Model.Products.Count() sản phẩm</strong>. 
                        Khi xóa danh mục này, <strong class="text-danger">TẤT CẢ các sản phẩm liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống</strong> (bao gồm cả dữ liệu và file hình ảnh trên máy tính).
                    </p>
                </div>

                <form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-danger btn-luxe-delete-admin flex-grow-1">XÓA VĨNH VIỄN</button>
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-luxe-cancel-admin">HỦY BỎ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .luxe-form-title {
        font-family: 'Playfair Display', 'Inter', sans-serif;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 2px;
        margin: 0;
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    .btn-danger.btn-luxe-delete-admin {
        background-color: #dc3545;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 14px;
        border-radius: 0;
        border: none;
        transition: background-color 0.2s;
    }

    .btn-danger.btn-luxe-delete-admin:hover {
        background-color: #c82333;
    }

    .btn-luxe-cancel-admin {
        background-color: #ffffff;
        color: #777777;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 14px 28px;
        border-radius: 0;
        border: 1px solid #e0e0e0;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s;
    }

    .btn-luxe-cancel-admin:hover {
        background-color: #fafafa;
        color: #111111;
        border-color: #111111;
    }
</style>
