@model IEnumerable<BTT3_KimNgan.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml"; // Sử dụng chung Layout hệ thống của bạn
}

<div class="luxe-admin-container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="luxe-admin-title">BẢNG ĐIỀU KHIỂN QUẢN TRỊ</h2>
            <p class="text-muted small text-uppercase tracking-wider">Quản lý danh mục hàng hóa hệ thống LUXÉ</p>
        </div>
        <div>
            @if (User.Identity.IsAuthenticated && User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
            {
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-luxe-dark">
                    <i class="bi bi-plus-lg"></i> THÊM SẢN PHẨM MỚI
                </a>
            }
        </div>
    </div>

    <div class="table-responsive luxe-table-wrapper">
        <table class="table table-hover align-middle m-0">
            <thead>
                <tr>
                    <th style="width: 15%;">Hình ảnh</th>
                    <th style="width: 25%;">Tên sản phẩm</th>
                    <th style="width: 15%;">Mã SKU</th>
                    <th style="width: 15%;">Giá bán</th>
                    <th style="width: 30%;" class="text-end">Thao tác quản lý</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="luxe-img-container">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="luxe-admin-thumb" />
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <div class="text-muted small">@item.Description?.Substring(0, Math.Min(40, item.Description?.Length ?? 0))...</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border tracking-wider">@item.Sku</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-danger">@item.Price.ToString("#,##0") ₫</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group gap-2">
                                    @if (User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
                                    {
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary luxe-btn-action">
                                            Sửa
                                        </a>
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger luxe-btn-action">
                                            Xóa
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    // Dữ liệu mẫu hiển thị khi database trống để test giao diện
                    <tr>
                        <td>
                            <div class="luxe-img-container">
                                <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?q=80&w=600" class="luxe-admin-thumb" />
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">STRUCTURED WOOL OVERCOAT</div>
                            <div class="text-muted small">Được may thủ công tinh tế từ chất liệu 100% len cao cấp...</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">LFA-2024-WO-01</span></td>
                        <td><span class="fw-semibold text-danger">895,000 ₫</span></td>
                        <td class="text-end">
                            <div class="btn-group gap-2">
                                @if (User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
                                {
                                    <button class="btn btn-sm btn-outline-secondary luxe-btn-action">Sửa</button>
                                    <button class="btn btn-sm btn-outline-danger luxe-btn-action">Xóa</button>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="luxe-img-container">
                                <img src="https://images.unsplash.com/photo-1595777457583-95e059d581b8?q=80&w=600" class="luxe-admin-thumb" />
                            </div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">ASYMMETRIC SILK MIDI DRESS</div>
                            <div class="text-muted small">Được thiết kế sang trọng từ 100% lụa dâu tằm tự nhiên...</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">LFA-2024-SD-02</span></td>
                        <td><span class="fw-semibold text-danger">450,000 ₫</span></td>
                        <td class="text-end">
                            <div class="btn-group gap-2">
                                @if (User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
                                {
                                    <button class="btn btn-sm btn-outline-secondary luxe-btn-action">Sửa</button>
                                    <button class="btn btn-sm btn-outline-danger luxe-btn-action">Xóa</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Các thuộc tính CSS giữ nguyên hoàn toàn như file cũ của bạn */
    .luxe-admin-title {
        font-family: 'Playfair Display', 'Inter', sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #111111;
        margin: 0;
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    .btn-luxe-dark {
        background-color: #111111;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 12px 24px;
        border-radius: 0;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-luxe-dark:hover {
            background-color: #333333;
            color: #ffffff;
        }

    .luxe-table-wrapper {
        border: 1px solid #eeeeee;
        background-color: #ffffff;
    }

        .luxe-table-wrapper th {
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            text-uppercase: uppercase;
            letter-spacing: 1px;
            background-color: #fafafa;
            color: #555555;
            padding: 16px;
            border-bottom: 1px solid #eeeeee;
        }

        .luxe-table-wrapper td {
            padding: 16px;
            border-bottom: 1px solid #f6f6f6;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

    .luxe-img-container {
        width: 60px;
        height: 75px;
        overflow: hidden;
        background-color: #f9f9f9;
        border: 1px solid #eaeaea;
    }

    .luxe-admin-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .luxe-btn-action {
        border-radius: 0;
        font-size: 12px;
        padding: 5px 14px;
    }
</style>