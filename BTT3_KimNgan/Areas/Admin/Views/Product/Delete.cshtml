@model BTT3_KimNgan.Models.Product

@{
    ViewData["Title"] = "Xóa Sản Phẩm - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 border text-center bg-white">
                <h3 class="text-danger fw-bold mb-3" style="letter-spacing: 1px;">XÁC NHẬN XÓA?</h3>
                <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này khỏi hệ thống không? Hành động này không thể hoàn tác.</p>

                <div class="card border-0 bg-light p-3 mb-4 d-flex flex-row align-items-center gap-3 text-start">
                    <img src="@Model.ImageUrl" style="width: 70px; height: 90px; object-fit: cover; border: 1px solid #ddd;" />
                    <div>
                        <div class="fw-bold text-dark">@Model.Name</div>
                        <div class="text-danger small fw-semibold">@Model.Price.ToString("#,##0") ₫</div>
                        <div class="text-muted small">SKU: @Model.Sku</div>
                    </div>
                </div>

                <form asp-area="Admin" asp-controller="Product" asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-0 small fw-bold" style="font-size: 12px; letter-spacing: 1px;">XÓA BỎ VĨNH VIỄN</button>
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-0" style="font-size: 12px;">HỦY</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>