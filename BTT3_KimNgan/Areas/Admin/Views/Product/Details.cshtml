@model BTT3_KimNgan.Models.Product

@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 border p-5 bg-white">
            <div class="row">
                <div class="col-md-5">
                    <img src="@Model.ImageUrl" class="w-100 border" style="aspect-ratio: 3/4; object-fit: cover;" />
                </div>
                <div class="col-md-7 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-dark rounded-0 mb-2 px-3 py-2 text-uppercase tracking-wider" style="font-size: 10px;">ID Danh Mục: @Model.CategoryId</span>
                        <h2 style="font-family: 'Playfair Display', sans-serif; font-weight: 700; letter-spacing: 1px;">@Model.Name</h2>
                        <h4 class="text-danger fw-semibold my-3">@Model.Price.ToString("#,##0") đ</h4>
                        <p class="text-muted small mb-2"><strong>Mã sản phẩm (SKU):</strong> @Model.Sku</p>
                        <hr />
                        <p class="text-secondary" style="font-size: 14px; line-height: 1.6;">@Model.Description</p>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark rounded-0 px-4 py-2" style="font-size: 12px;">CHỈNH SỬA</a>
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-0 px-4 py-2" style="font-size: 12px;">QUAY LẠI</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>