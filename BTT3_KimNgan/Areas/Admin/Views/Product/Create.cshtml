@model BTT3_KimNgan.Models.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới - LUXÉ Admin";
    Layout = "/Views/Shared/_Layout.cshtml"; // Dùng chung layout hệ thống của bạn
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="luxe-admin-card p-5 border">
                <div class="mb-4">
                    <h2 class="luxe-form-title">THÊM SẢN PHẨM</h2>
                    <p class="text-muted small text-uppercase tracking-wider">Nhập thông tin chi tiết cho sản phẩm mới của LUXÉ</p>
                    <hr />
                </div>

                <form asp-area="Admin" asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-4 align-items-center">
                        <label asp-for="Name" class="col-md-3 luxe-label mb-0">Tên sản phẩm</label>
                        <div class="col-md-9">
                            <input asp-for="Name" class="form-control luxe-input-form" placeholder="Ví dụ: STRUCTURED WOOL OVERCOAT" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4 align-items-center">
                        <label asp-for="Sku" class="col-md-3 luxe-label mb-0">Mã sản phẩm (SKU)</label>
                        <div class="col-md-9">
                            <input asp-for="Sku" class="form-control luxe-input-form" placeholder="LFA-2026-WO-01" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4 align-items-center">
                        <label asp-for="Price" class="col-md-3 luxe-label mb-0">Giá bán (VNĐ)</label>
                        <div class="col-md-9">
                            <input asp-for="Price" type="number" class="form-control luxe-input-form" placeholder="895000" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4 align-items-center">
                        <label class="col-md-3 luxe-label mb-0">Hình ảnh sản phẩm</label>
                        <div class="col-md-9">
                            <input type="file" name="file" class="form-control luxe-input-form" accept="image/*" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4 align-items-center">
                        <label asp-for="CategoryId" class="col-md-3 luxe-label mb-0">Danh mục sản phẩm</label>
                        <div class="col-md-9">
                            <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select luxe-input-form">
                                <option disabled selected>-- Chọn danh mục thời trang --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-5 align-items-start">
                        <label asp-for="Description" class="col-md-3 luxe-label mt-2">Mô tả chi tiết</label>
                        <div class="col-md-9">
                            <textarea asp-for="Description" class="form-control luxe-input-form" rows="4" placeholder="Chất liệu, form dáng, hướng dẫn bảo quản..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-9 offset-md-3 d-flex gap-3">
                            <button type="submit" class="btn btn-luxe-submit-admin flex-grow-1">LƯU SẢN PHẨM</button>
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-luxe-cancel-admin">HỦY BỎ</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS Định dạng form điền thông tin tối giản phong cách LUXÉ */
    .luxe-form-title {
        font-family: 'Playfair Display', 'Inter', sans-serif;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #111111;
        margin: 0;
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    .luxe-label {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        text-uppercase: uppercase;
        letter-spacing: 1px;
        color: #444444;
        margin-bottom: 8px;
        display: block;
    }

    .luxe-input-form {
        border-radius: 0 !important;
        border: 1px solid #e0e0e0 !important;
        padding: 12px 16px !important;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #111111;
        transition: border-color 0.2s;
    }

    /* Đảm bảo style của thẻ select đồng bộ với input */
    select.luxe-input-form {
        background-position: right 16px center;
        padding-right: 40px !important;
    }

    .luxe-input-form:focus {
        border-color: #111111 !important;
        box-shadow: none !important;
    }

    .btn-luxe-submit-admin {
        background-color: #111111;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 14px;
        border-radius: 0;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-luxe-submit-admin:hover {
            background-color: #333333;
            color: #ffffff;
        }

    .btn-luxe-cancel-admin {
        background-color: #ffffff;
        color: #777777;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 1px;
        padding: 14px 28px;
        border-radius: 0;
        border: 1px solid #e0e0e0;
        text-decoration: none;
        text-align: center;
        transition: all 0.2s;
    }

        .btn-luxe-cancel-admin:hover {
            background-color: #fafafa;
            color: #111111;
            border-color: #111111;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}