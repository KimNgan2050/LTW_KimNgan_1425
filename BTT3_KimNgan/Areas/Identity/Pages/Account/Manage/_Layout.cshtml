@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-11 col-lg-10">
            <div class="luxe-profile-card p-4 p-md-5 border">
                <div class="mb-4">
                    <h2 class="luxe-profile-title">HỒ SƠ CÁ NHÂN</h2>
                    <p class="text-muted small text-uppercase tracking-wider">Cập nhật hồ sơ cá nhân và cấu hình bảo mật tài khoản của bạn</p>
                    <hr class="luxe-hr" />
                </div>

                <div class="row mt-4">
                    <div class="col-md-3 border-end">
                        <partial name="_ManageNav" />
                    </div>
                    <div class="col-md-9 ps-md-5 mt-4 mt-md-0">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .luxe-profile-card {
        background-color: #ffffff;
        border-radius: 0;
        border: 1px solid #eeeeee !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .luxe-profile-title {
        font-family: 'Inter', sans-serif;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: 3px;
        color: #000000;
        margin: 0;
    }

    .tracking-wider {
        letter-spacing: 1.5px;
        font-size: 11px !important;
        color: #777777 !important;
        margin-top: 5px;
    }

    .luxe-hr {
        border-top: 1px solid #eeeeee;
        opacity: 1;
        margin-top: 15px;
    }

    /* Style menu điều hướng bên trái */
    .luxe-manage-nav {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .luxe-manage-nav li {
        margin-bottom: 6px;
    }

    .luxe-nav-link {
        display: block;
        padding: 12px 16px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        color: #666666;
        text-decoration: none;
        letter-spacing: 0.5px;
        border-left: 3px solid transparent;
        transition: all 0.2s ease;
    }

    .luxe-nav-link:hover {
        color: #000000;
        background-color: #f9f9f9;
    }

    .luxe-nav-link.active {
        color: #000000;
        background-color: #f9f9f9;
        border-left-color: #000000;
        font-weight: 600;
    }

    /* Định dạng lại Form, Input và Button mặc định của Identity */
    .col-md-9 form h3,
    .col-md-9 form h4,
    .col-md-9 h4 {
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #000000;
        margin-top: 0;
        margin-bottom: 25px;
        border-bottom: 1px solid #eeeeee;
        padding-bottom: 12px;
    }

    /* Đè CSS cho các Input của Bootstrap */
    .col-md-9 .form-control,
    .col-md-9 .form-select {
        border-radius: 0 !important;
        border: 1px solid #e0e0e0 !important;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #000000;
        transition: border-color 0.2s;
    }

    .col-md-9 .form-control:focus,
    .col-md-9 .form-select:focus {
        border-color: #000000 !important;
        box-shadow: none !important;
    }

    /* Đảm bảo căn chỉnh cho nhãn không trôi (nhãn thường) */
    .col-md-9 label:not(.form-floating > label) {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 1px;
        color: #000000;
        margin-bottom: 8px;
        display: block;
    }

    /* Hỗ trợ hiển thị nhãn trôi (floating labels) chuẩn Bootstrap 5 */
    .col-md-9 .form-floating {
        position: relative;
    }

    .col-md-9 .form-floating > .form-control {
        height: 58px !important;
        padding: 1.6rem 12px 0.6rem 16px !important;
    }

    .col-md-9 .form-floating > label {
        padding: 1rem 16px !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        color: #888888 !important;
        letter-spacing: 0.5px;
        display: inline-block !important;
        margin-bottom: 0 !important;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        transform-origin: 0 0;
        transition: opacity .1s ease-in-out, transform .1s ease-in-out;
    }

    /* Khi label thu nhỏ lại khi có giá trị hoặc được focus */
    .col-md-9 .form-floating > .form-control:focus ~ label,
    .col-md-9 .form-floating > .form-control:not(:placeholder-shown) ~ label {
        opacity: .75;
        transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
    }


    /* Đè CSS cho các Nút bấm chính (Save, Change, v.v.) */
    .col-md-9 .btn-primary,
    .col-md-9 button[type="submit"]:not(.btn-link):not(#email-verification) {
        background-color: #000000 !important;
        border: 1px solid #000000 !important;
        color: #ffffff !important;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        padding: 14px 28px !important;
        border-radius: 0 !important;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

    .col-md-9 .btn-primary:hover,
    .col-md-9 button[type="submit"]:not(.btn-link):not(#email-verification):hover {
        background-color: #ffffff !important;
        color: #000000 !important;
    }

    /* Nút phụ / Link button */
    .col-md-9 .btn-link,
    .col-md-9 #email-verification {
        background: none !important;
        border: none !important;
        color: #707070 !important;
        text-decoration: underline !important;
        font-size: 13px !important;
        font-family: 'Inter', sans-serif !important;
        font-weight: 500 !important;
        padding: 8px 0 !important;
        letter-spacing: 0.5px;
        text-transform: none !important;
        display: inline-block;
        margin-top: 5px;
        transition: color 0.2s;
    }

    .col-md-9 .btn-link:hover,
    .col-md-9 #email-verification:hover {
        color: #000000 !important;
        background: none !important;
    }


    /* CSS cho Nút Danger (như nút Xóa dữ liệu cá nhân) */
    .col-md-9 .btn-danger {
        background-color: #dc3545 !important;
        border: 1px solid #dc3545 !important;
        color: #ffffff !important;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        padding: 14px 28px !important;
        border-radius: 0 !important;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

    .col-md-9 .btn-danger:hover {
        background-color: #ffffff !important;
        color: #dc3545 !important;
    }

    /* Hiệu ứng Alert thành công / thất bại */
    .col-md-9 .alert-success {
        background-color: #f9f9f9;
        border: 1px solid #eeeeee;
        color: #2e7d32;
        border-radius: 0;
        font-size: 13px;
        letter-spacing: 0.5px;
        padding: 15px;
        font-weight: 500;
    }

    .col-md-9 .text-danger {
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }

    .col-md-9 .alert-danger {
        background-color: #fff8f8;
        border: 1px solid #ffd2d2;
        color: #c62828;
        border-radius: 0;
        font-size: 13px;
        padding: 15px;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        function translateProfilePage() {
            // Dịch tiêu đề h4/h3 bên trong vùng hiển thị nội dung
            const headings = document.querySelectorAll('.col-md-9 h4, .col-md-9 h3');
            headings.forEach(h => {
                const text = h.textContent.trim().toLowerCase();
                if (text === 'profile') {
                    h.textContent = 'Thông tin cá nhân';
                } else if (text === 'manage email') {
                    h.textContent = 'Cập nhật địa chỉ Email';
                } else if (text === 'change password') {
                    h.textContent = 'Đổi mật khẩu tài khoản';
                } else if (text === 'two-factor authentication (2fa)') {
                    h.textContent = 'Bảo mật 2 lớp (2FA)';
                } else if (text === 'personal data') {
                    h.textContent = 'Dữ liệu cá nhân';
                }
            });

            // Dịch các nhãn (label) nhập liệu
            const labels = document.querySelectorAll('.col-md-9 label');
            labels.forEach(l => {
                const text = l.textContent.trim().toLowerCase();
                if (text === 'username') {
                    l.textContent = 'Tên đăng nhập / Email';
                } else if (text === 'phone number') {
                    l.textContent = 'Số điện thoại liên hệ';
                } else if (text === 'email') {
                    l.textContent = 'Địa chỉ Email hiện tại';
                } else if (text === 'new email') {
                    l.textContent = 'Địa chỉ Email mới';
                } else if (text === 'confirm new email') {
                    l.textContent = 'Xác nhận địa chỉ Email mới';
                } else if (text === 'current password') {
                    l.textContent = 'Mật khẩu hiện tại';
                } else if (text === 'new password') {
                    l.textContent = 'Mật khẩu mới';
                } else if (text === 'confirm new password') {
                    l.textContent = 'Xác nhận mật khẩu mới';
                }
            });

            // Dịch các nút bấm (button)
            const buttons = document.querySelectorAll('.col-md-9 button[type="submit"], .col-md-9 .btn');
            buttons.forEach(b => {
                const text = b.textContent.trim().toLowerCase();
                if (text === 'save') {
                    b.textContent = 'Lưu thông tin';
                } else if (text === 'change email') {
                    b.textContent = 'Thay đổi Email';
                } else if (text === 'send verification email') {
                    b.textContent = 'Gửi Email xác thực';
                } else if (text === 'update password') {
                    b.textContent = 'Cập nhật mật khẩu';
                } else if (text === 'download') {
                    b.textContent = 'Tải xuống dữ liệu';
                } else if (text === 'delete') {
                    b.textContent = 'Xóa dữ liệu tài khoản';
                }
            });

            // Dịch các đoạn mô tả tại phần Dữ liệu cá nhân
            const paragraphs = document.querySelectorAll('.col-md-9 p');
            paragraphs.forEach(p => {
                let html = p.innerHTML;
                if (html.includes("Your account contains personal data that you have given us")) {
                    p.innerHTML = "Tài khoản của bạn chứa các thông tin dữ liệu cá nhân mà bạn đã cung cấp cho chúng tôi. Bạn có thể tải xuống hoặc yêu cầu xóa bỏ hoàn toàn dữ liệu này.";
                }
                if (html.includes("Deleting this data will permanently delete your account")) {
                    p.innerHTML = "<strong>Cảnh báo:</strong> Việc xóa dữ liệu này sẽ xóa vĩnh viễn tài khoản của bạn. Hành động này không thể khôi phục lại được.";
                }
            });

            // Dịch thông báo trạng thái
            const alerts = document.querySelectorAll('.col-md-9 .alert');
            alerts.forEach(a => {
                let text = a.textContent.trim();
                if (text.includes("Your profile has been updated")) {
                    a.innerHTML = "Cập nhật hồ sơ cá nhân thành công.";
                } else if (text.includes("Verification email sent. Please check your email.")) {
                    a.innerHTML = "Thư xác thực đã được gửi. Vui lòng kiểm tra hộp thư của bạn.";
                } else if (text.includes("Your email is unchanged.")) {
                    a.innerHTML = "Địa chỉ email không thay đổi.";
                } else if (text.includes("Your password has been changed.")) {
                    a.innerHTML = "Thay đổi mật khẩu thành công.";
                }
            });
        }

        // Chạy ngay khi tải xong DOM
        translateProfilePage();
        
        // Chạy lại sau 100ms và 300ms đề phòng render chậm
        setTimeout(translateProfilePage, 100);
        setTimeout(translateProfilePage, 300);
    });
</script>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

