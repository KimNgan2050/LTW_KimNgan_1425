@model int

@{
    ViewData["Title"] = "Đặt Hàng Thành Công - Luxe Fashion";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    .luxe-success-container {
        font-family: 'Inter', sans-serif;
        color: #000;
        margin-top: 80px;
        margin-bottom: 100px;
    }

    .success-icon {
        font-size: 60px;
        color: #000000;
        margin-bottom: 30px;
    }

    .success-title {
        font-size: 22px;
        letter-spacing: 3px;
        text-transform: uppercase;
        font-weight: 400;
        margin-bottom: 20px;
    }

    .success-text {
        font-size: 14px;
        color: #707070;
        max-width: 500px;
        margin: 0 auto 30px auto;
        line-height: 1.6;
    }

    .order-id-box {
        display: inline-block;
        border: 1px solid #000000;
        padding: 15px 40px;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 40px;
        font-weight: 500;
    }

    .btn-back-home {
        background-color: #000000;
        color: #ffffff;
        border-radius: 0;
        padding: 14px 35px;
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.2s;
    }

        .btn-back-home:hover {
            background-color: #222222;
            color: #ffffff;
        }
</style>

<div class="container text-center luxe-success-container">
    <div class="success-icon">
        <i class="bi bi-check-circle"></i>
    </div>

    <h1 class="success-title">Đặt hàng thành công</h1>

    <p class="success-text">
        Cảm ơn bạn đã lựa chọn mua sắm tại <strong>LUXÉ FASHION</strong>.<br />
        Yêu cầu đặt hàng của bạn đã được hệ thống ghi nhận thành công và đang được xử lý.
    </p>

    <div class="order-id-box">
        Mã số đơn hàng: <span style="font-weight: 600;">#@Model</span>
    </div>

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-back-home">Tiếp tục mua sắm</a>
    </div>
</div>