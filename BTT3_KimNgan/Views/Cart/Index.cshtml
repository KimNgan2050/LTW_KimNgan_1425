@model IEnumerable<BTT3_KimNgan.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn - Luxe Fashion";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    .luxe-cart-container {
        font-family: 'Inter', sans-serif;
        color: #000;
        margin-top: 50px;
        margin-bottom: 80px;
    }

    .cart-title {
        font-size: 22px;
        letter-spacing: 3px;
        text-transform: uppercase;
        font-weight: 400;
        margin-bottom: 40px;
    }

    .cart-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cart-table th {
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 600;
            padding-bottom: 20px;
            border-bottom: 1px solid #e0e0e0;
            color: #707070;
        }

        .cart-table td {
            padding: 25px 0;
            border-bottom: 1px solid #f2f2f2;
            vertical-align: middle;
        }

    .cart-img-box {
        width: 80px;
        aspect-ratio: 3 / 4;
        background-color: #f5f5f3;
        overflow: hidden;
    }

        .cart-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .cart-item-name {
        font-size: 13px;
        text-transform: uppercase;
        font-weight: 500;
        letter-spacing: 1px;
        color: #000;
        text-decoration: none;
    }

    .cart-item-sku {
        font-size: 11px;
        color: #707070;
        margin-top: 4px;
    }

    .quantity-text {
        font-size: 14px;
        font-weight: 500;
    }

    .btn-remove-item {
        color: #707070;
        text-decoration: none;
        font-size: 13px;
    }

        .btn-remove-item:hover {
            color: #000;
            text-decoration: underline;
        }

    .summary-box {
        background-color: #f9f9f9;
        padding: 30px;
        border: 1px solid #f2f2f2;
    }

    .summary-title {
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 25px;
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 15px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .btn-checkout {
        background-color: #000000;
        color: #ffffff;
        border-radius: 0;
        padding: 14px;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        width: 100%;
        border: none;
        margin-top: 20px;
        transition: background-color 0.2s;
    }

        .btn-checkout:hover {
            background-color: #222222;
        }
</style>

<div class="container luxe-cart-container">
    <h1 class="cart-title">Lựa chọn của bạn.</h1>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-8 mb-5 mb-lg-0">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th style="width: 15%;">01. GIỎ HÀNG CỦA BẠN</th>
                            <th style="width: 45%;"></th>
                            <th style="width: 15%; text-align: center;">Số lượng</th>
                            <th style="width: 15%; text-align: right;">Số tiền</th>
                            <th style="width: 10%;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="cart-img-box">
                                        @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?q=80&w=600';" />
                                        }
                                        else
                                        {
                                            <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=600" alt="@item.Product.Name" />
                                        }
                                    </div>
                                </td>
                                <td>
                                    <a href="/Products/Details/@item.Product.Id" class="cart-item-name">@item.Product.Name</a>
                                    <div class="cart-item-sku">Mã số: @item.Product.Sku</div>
                                </td>
                                <td style="text-align: center;">
                                    <span class="quantity-text">@item.Quantity</span>
                                </td>
                                <td style="text-align: right; font-weight: 500;">
                                    @((item.Product.Price * item.Quantity).ToString("#,##0")) đ
                                </td>
                                <td style="text-align: right;">
                                    <a href="/Cart/RemoveFromCart/@item.Product.Id" class="btn-remove-item">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-lg-4 ps-lg-5">
                <div class="summary-box">
                    <h5 class="summary-title">Tóm tắt đơn hàng</h5>

                    <div class="summary-row">
                        <span style="color: #707070;">Tạm tính:</span>
                        <span style="font-weight: 500;">@(Model.Sum(i => i.Product.Price * i.Quantity).ToString("#,##0")) đ</span>
                    </div>

                    <div class="summary-row">
                        <span style="color: #707070;">Phí vận chuyển:</span>
                        <span style="color: #28a745; font-size: 13px; font-weight: 500;">MIỄN PHÍ</span>
                    </div>

                    <div class="summary-row mt-4 pt-3 border-top" style="font-weight: 600; font-size: 16px;">
                        <span>Tổng thanh toán:</span>
                        <span>@(Model.Sum(i => i.Product.Price * i.Quantity).ToString("#,##0")) đ</span>
                    </div>

                    <button class="btn btn-checkout" style="background-color: #ff7043;">HOÀN TẤT ĐẶT HÀNG</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <p style="color: #707070; font-size: 15px; margin-bottom: 25px;">Giỏ hàng của bạn đang trống.</p>
            <a href="/Products" class="btn btn-dark rounded-0 text-uppercase" style="font-size: 11px; letter-spacing: 2px; padding: 12px 30px; text-decoration: none;">Tiếp tục mua sắm</a>
        </div>
    }
</div>