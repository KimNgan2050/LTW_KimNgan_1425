@model BTT3_KimNgan.Models.Product

@{
    ViewData["Title"] = "Chỉnh Sửa Sản Phẩm - Luxe Fashion";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>
    .luxe-form-container {
        font-family: 'Inter', sans-serif;
        max-width: 600px;
        margin: 60px auto;
        color: #000;
    }

    .form-title {
        font-size: 20px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 400;
        margin-bottom: 30px;
        text-align: center;
    }

    .form-label {
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 0;
        border: 1px solid #e0e0e0;
        padding: 12px;
        font-size: 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #000;
            box-shadow: none;
        }

    .btn-save {
        background: #000;
        color: #fff;
        border-radius: 0;
        padding: 12px;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 2px;
        width: 100%;
        border: none;
        margin-top: 15px;
    }

        .btn-save:hover {
            background: #222;
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
        color: #707070;
        text-decoration: underline;
    }
</style>

<div class="container luxe-form-container">
    <h2 class="form-title">Cập Nhật Sản Phẩm</h2>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 13px;"></div>

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" placeholder="Ví dụ: STRUCTURED WOOL OVERCOAT" />
            <span asp-validation-for="Name" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Sku" class="form-label">Mã sản phẩm (SKU)</label>
            <input asp-for="Sku" class="form-control" placeholder="Ví dụ: LFA-2024-WO-01" />
            <span asp-validation-for="Sku" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Giá bán (VNĐ)</label>
            <input asp-for="Price" class="form-control" type="number" placeholder="Ví dụ: 550000" />
            <span asp-validation-for="Price" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">Đường Dẫn Hình Ảnh (URL)</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="Dán link ảnh từ mạng vào đây (https://...)" />
            <span asp-validation-for="ImageUrl" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Danh mục thời trang</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
            <span asp-validation-for="CategoryId" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label">Mô tả sản phẩm</label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập chất liệu, kiểu dáng..."></textarea>
            <span asp-validation-for="Description" class="text-danger" style="font-size: 12px;"></span>
        </div>

        <button type="submit" class="btn btn-save">LƯU THAY ĐỔI</button>
    </form>

    <a asp-action="Index" class="back-link">Quay lại cửa hàng</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}