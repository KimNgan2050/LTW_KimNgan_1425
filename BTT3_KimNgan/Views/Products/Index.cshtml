@model IEnumerable<BTT3_KimNgan.Models.Product>

@{
    ViewData["Title"] = "Tất Cả Sản Phẩm - Luxe Fashion";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    .luxe-shop-container {
        font-family: 'Inter', sans-serif;
        color: #000;
        margin-top: 50px;
    }

    .shop-title {
        font-size: 22px;
        letter-spacing: 3px;
        text-transform: uppercase;
        font-weight: 400;
        margin-bottom: 40px;
    }

    .filter-heading {
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .filter-list {
        list-style: none;
        padding-left: 0;
    }

    .filter-item-link {
        display: block;
        padding: 6px 0;
        color: #707070;
        text-decoration: none;
        font-size: 13px;
    }

        .filter-item-link:hover, .filter-item-link.active {
            color: #000;
            font-weight: 500;
        }

    .size-box {
        width: 38px;
        height: 38px;
        border: 1px solid #e0e0e0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #000;
        text-decoration: none;
        margin-right: 5px;
        margin-bottom: 8px;
    }

        .size-box:hover {
            border-color: #000;
            background-color: #000;
            color: #fff;
        }

    .product-grid-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 30px 20px;
    }

    .product-card-item {
        flex: 0 0 calc(33.333% - 14px);
        text-align: center;
        margin-bottom: 30px;
    }

    .product-img-box {
        background-color: #f5f5f3;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        margin-bottom: 15px;
    }

        .product-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .product-card-item:hover .product-img-box img {
        transform: scale(1.02);
    }

    .product-item-name {
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
        margin-bottom: 4px;
        color: #000;
    }

    .product-item-price {
        font-size: 12px;
        color: #707070;
    }

    .admin-actions {
        font-size: 12px;
        margin-top: 10px;
        color: #707070;
    }

        .admin-actions a {
            color: #000;
            margin: 0 2px;
            text-decoration: none;
            font-weight: 400;
        }

            .admin-actions a.btn-add-cart-link {
                font-weight: 500;
            }

            .admin-actions a:hover {
                text-decoration: underline;
                color: #707070;
            }

    /* PHÂN TRANG LUXÉ TỐI GIẢN */
    .luxe-pagination {
        font-family: 'Inter', sans-serif;
        margin-top: 50px;
        margin-bottom: 30px;
    }

    .pag-num {
        font-size: 14px;
        color: #707070;
        text-decoration: none;
        padding-bottom: 5px;
        border-bottom: 1.5px solid transparent;
        transition: all 0.2s;
        min-width: 24px;
        text-align: center;
        display: inline-block;
        font-weight: 400;
    }

    .pag-num:hover {
        color: #000;
    }

    .pag-num.active {
        color: #000;
        font-weight: 500;
        border-bottom: 1.5px solid #000;
    }

    .pag-arrow {
        font-size: 13px;
        color: #000;
        text-decoration: none;
        transition: opacity 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .pag-arrow:hover {
        opacity: 0.7;
    }
</style>

<div class="container luxe-shop-container">
    @if (User.Identity.IsAuthenticated && User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
    {
        <div class="row mb-3">
            <div class="col text-end">
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-dark btn-sm rounded-0" style="font-size: 11px; letter-spacing: 1px; padding: 10px 20px;">+ THÊM SẢN PHẨM MỚI</a>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-3">
            <div class="mb-5">
                <h6 class="filter-heading">Danh Mục Sản Phẩm</h6>
                <ul class="filter-list">
                    <li><a href="/Products" class="filter-item-link">Tất Cả Quần Áo</a></li>
                    <li><a href="/Products?category=Áo khoác" class="filter-item-link">Áo Khoác ngoài</a></li>
                    <li><a href="/Products?category=Váy đầm" class="filter-item-link">Váy Đầm Thời Trang</a></li>
                    <li><a href="/Products?category=T-shirt" class="filter-item-link">Áo thun T-shirt</a></li>
                    <li><a href="/Products?category=Hoodie" class="filter-item-link">Áo Hoodie</a></li>
                    <li><a href="/Products?category=Phụ kiện" class="filter-item-link">Phụ Kiện đi kèm</a></li>
                </ul>
            </div>

            <div>
                <h6 class="filter-heading">Kích Cỡ</h6>
                <div class="d-flex flex-wrap">
                    <a href="#" class="size-box">XS</a>
                    <a href="#" class="size-box">S</a>
                    <a href="#" class="size-box">M</a>
                    <a href="#" class="size-box">L</a>
                    <a href="#" class="size-box">XL</a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <h2 class="shop-title">Cửa Hàng</h2>

            <div class="product-grid-wrapper">
                @foreach (var item in Model)
                {
                    <div class="product-card-item">
                        <a href="/Products/Details/@item.Id" style="text-decoration: none;">
                            <div class="product-img-box">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?q=80&w=600';" />
                                }
                                else
                                {
                                    <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=600" alt="@item.Name" />
                                }
                            </div>
                            <div class="product-item-name">@item.Name</div>
                            <div class="product-item-price">@item.Price.ToString("#,##0") đ</div>
                        </a>

                        <div class="admin-actions">
                            <a href="/Cart/AddToCart/@item.Id" class="btn-add-cart-link">Thêm vào giỏ</a>

                            @if (User.Identity.IsAuthenticated && User.IsInRole(BTT3_KimNgan.Models.SD.Role_Admin))
                            {
                                <span class="mx-1">|</span>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                <span class="mx-1">|</span>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- PHÂN TRANG LUXÉ -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="luxe-pagination d-flex justify-content-center align-items-center mt-5 gap-4">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a href="/Products?category=@ViewBag.CurrentCategory&page=@(ViewBag.CurrentPage - 1)" class="pag-arrow">◀</a>
                    }
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                            <span class="pag-num active">@i</span>
                        }
                        else
                        {
                            <a href="/Products?category=@ViewBag.CurrentCategory&page=@i" class="pag-num">@i</a>
                        }
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a href="/Products?category=@ViewBag.CurrentCategory&page=@(ViewBag.CurrentPage + 1)" class="pag-arrow">▶</a>
                    }
                </div>
            }
        </div>
    </div>
</div>