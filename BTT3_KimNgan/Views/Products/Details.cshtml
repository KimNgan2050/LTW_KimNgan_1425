@model BTT3_KimNgan.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Chi Tiết Sản Phẩm";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    .luxe-details-container {
        font-family: 'Inter', sans-serif;
        color: #000;
        margin-top: 60px;
        margin-bottom: 80px;
    }

    .product-sku {
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #707070;
        margin-bottom: 8px;
    }

    .product-name {
        font-size: 24px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 500;
        margin-bottom: 15px;
        line-height: 1.3;
    }

    .product-price {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 35px;
        color: #000;
    }

    .product-description {
        font-size: 14px;
        color: #4a4a4a;
        line-height: 1.7;
        margin-bottom: 40px;
        white-space: pre-line;
    }

    /* Tối ưu nút bấm hành động */
    .btn-action {
        border-radius: 0;
        padding: 14px;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        width: 100%;
        margin-bottom: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
        text-align: center;
        display: block;
    }

    .btn-add-cart {
        background-color: #000000;
        color: #ffffff;
        border: none;
        text-decoration: none;
    }

        .btn-add-cart:hover {
            background-color: #222222;
            color: #ffffff;
        }

    .btn-back {
        background-color: #ffffff;
        color: #000000;
        border: 1px solid #000000;
        text-decoration: none;
    }

        .btn-back:hover {
            background-color: #000000;
            color: #ffffff;
        }

    .img-box-details {
        background-color: #f5f5f3;
        aspect-ratio: 3 / 4;
        overflow: hidden;
    }

        .img-box-details img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

<div class="container luxe-details-container">
    <div class="row">

        <!-- CỘT BÊN TRÁI: HÌNH ẢNH SẢN PHẨM -->
        <div class="col-md-6 mb-4 mb-md-0">
            <div class="img-box-details">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?q=80&w=600';" />
                }
                else
                {
                    <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=600" alt="@Model.Name" />
                }
            </div>
        </div>

        <!-- CỘT BÊN PHẢI: THÔNG TIN CHI TIẾT -->
        <div class="col-md-6 ps-md-5">
            <div class="product-sku">Mã sản phẩm: @Model.Sku</div>
            <h1 class="product-name">@Model.Name</h1>

            <!-- ÉP HIỂN THỊ ĐỊNH DẠNG TIỀN VIỆT -->
            <div class="product-price">@Model.Price.ToString("#,##0") đ</div>

            <div class="product-description">
                @Model.Description
            </div>

            <div class="mt-4" style="max-width: 400px;">
                <a href="/Cart/AddToCart/@Model.Id" class="btn btn-action btn-add-cart">
                    Thêm vào giỏ hàng
                </a>

                <a asp-action="Index" class="btn btn-action btn-back">
                    Quay lại cửa hàng
                </a>
            </div>
        </div>

    </div>
</div>